{
  "name": "ayesh-desktop",
  "version": "0.1.0",
  "description": "Ayesh Desktop — Multi-Agent AI Orchestrator",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "dev": "bunx vite & NODE_ENV=development electron .",
    "dev:renderer": "bunx vite",
    "start": "electron .",
    "build": "bun run build:renderer && bunx electron-builder",
    "build:renderer": "bunx vite build",
    "package": "bunx electron-builder",
    "proto:generate": "bunx grpc_tools_node_protoc --js_out=import_style=commonjs,binary:src/grpc --grpc_out=src/grpc --proto_path=proto proto/ayesh.proto",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint src/",
    "test": "bun test"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.8.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "bun-types": "^1.4.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.16.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "grpc-tools": "^1.12.1",
    "postcss": "^8.4.47",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0"
  },
  "author": "Ayesh Team",
  "license": "MIT"
}
